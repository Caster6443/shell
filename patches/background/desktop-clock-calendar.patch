+    function dateKeyForDay(day: int): string {
+        const pad = value => String(value).padStart(2, "0");
+        return `${calendarDate.getFullYear()}-${pad(calendarDate.getMonth() + 1)}-${pad(day)}`;
+    }
+
+    function openTodos(day: int): void {
+        if (day < 1 || day > calendarDaysInMonth)
+            return;
+        todosDateKey = dateKeyForDay(day);
+        showingTodos = true;
+    }
+
+    function remind(task: var): void {
+        reminderText = task.title;
+        reminderTaskId = task.id || "";
+        reminderIsAlarm = task.kind === "alarm" || task.id === "desktop-alarm";
+        reminderIsTest = task.test === true;
+        reminderActive = true;
+        reminderTimer.restart();
+    }
+
+    function dismissReminder(): void {
+        reminderTimer.stop();
+        reminderText = "";
+        reminderTaskId = "";
+        reminderIsAlarm = false;
+        reminderIsTest = false;
+        reminderActive = false;
+    }
+
